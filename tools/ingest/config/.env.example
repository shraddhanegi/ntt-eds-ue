# SharePoint credentials for `npm run ingest -- --target=da` or `--target=both`
# Copy to project root as .env (never commit .env)

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SP_SITE_ID=
SP_DRIVE_ID=

# Universal Editor — push staged content after ingest with:
#   npx aem-import-helper aem upload --zip=... --token=$AEM_IMPORT_TOKEN --target=$AEM_TARGET
AEM_IMPORT_TOKEN=
AEM_TARGET=

# Optional: system Chrome for Puppeteer
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
